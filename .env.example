# Copy to .env (never commit it). rp bootstrap uploads it to the pod (mode 600).
HF_TOKEN=
# Results dataset for this project (created private if missing unless HF_DATASET_PUBLIC=1)
HF_DATASET_REPO=timf34/emotion-ensemble-forensics
HF_DATASET_PUBLIC=1
# SRH judges (Claude); OpenRouter is used, routed to Anthropic only, when ANTHROPIC_API_KEY is unset
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# lets an unattended pod job stop its own pod (SHUTDOWN=stop|terminate)
RUNPOD_API_KEY=
